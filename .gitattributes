* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.parquet binary
*.npz binary
*.pt binary
*.pkl binary
*.png binary

# GitHub Linguist overrides (exclude generated reports, HTML, and notebooks from language statistics)
reports/** linguist-documentation=true
*.html linguist-detectable=false
*.ipynb linguist-documentation=true
*.json linguist-documentation=true
